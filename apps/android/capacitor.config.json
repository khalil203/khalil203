{
  "appId": "com.khalil203.shoppos",
  "appName": "Yanisa Shop",
  "webDir": "www",
  "server": {
    "url": "https://khalil203.github.io/khalil203/pos/",
    "cleartext": false,
    "allowNavigation": [
      "khalil203.github.io",
      "*.supabase.co"
    ],
    "errorPath": "offline.html"
  },
  "android": {
    "backgroundColor": "#0b2b5e",
    "appendUserAgent": "ShopPOSApp"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": true,
      "backgroundColor": "#0b2b5e",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "Keyboard": {
      "resize": "body"
    },
    "StatusBar": {
      "backgroundColor": "#eef4ff",
      "style": "LIGHT",
      "overlaysWebView": false
    }
  }
}