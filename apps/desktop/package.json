{
  "name": "shop-pos",
  "productName": "Yanisa Shop",
  "version": "4.0.0",
  "description": "Yanisa Shop desktop app (Windows / macOS) — opens the live POS so it is always up to date",
  "main": "main.js",
  "author": "khalil203",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.khalil203.shoppos",
    "productName": "Yanisa Shop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "YanisaShop-Setup.${ext}"
    },
    "portable": {
      "artifactName": "YanisaShop-Portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "identity": null,
      "artifactName": "YanisaShop-mac.${ext}"
    },
    "dmg": {
      "artifactName": "YanisaShop-mac.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "khalil203",
        "repo": "khalil203",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/khalil203/khalil203.git"
  }
}